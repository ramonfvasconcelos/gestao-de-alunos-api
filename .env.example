# Banco usado pela API durante os testes
MONGODB_URI=mongodb://127.0.0.1:27017/gestao-de-alunos-test

# Segredo usado para assinar os tokens JWT
JWT_SECRET=segredo-dev-gestao-de-alunos

# Credenciais do administrador pré-cadastrado pelo seed
ADMIN_EMAIL=admin@escola.com
ADMIN_SENHA=admin123
